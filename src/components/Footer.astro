---
import { Image } from 'astro:assets';
import logo from '../assets/logo.svg';
import { kontakt, links } from '../lib/inhalte';

const spalten = [
  {
    titel: 'Verein',
    links: [
      { href: '/verein/', label: 'Der Verein' },
      { href: '/verein/ansprechpartner/', label: 'Ansprechpartner' },
      { href: '/verein/termine/', label: 'Termine' },
      { href: '/faq/', label: 'Häufige Fragen' },
      { href: '/mitglied-werden/', label: 'Mitglied werden' },
    ],
  },
  {
    titel: 'Sport',
    links: [
      { href: '/tennis/', label: 'Tennis' },
      { href: '/padel/', label: 'Padel' },
      { href: links.platzbuchung, label: 'Platz buchen' },
      { href: links.instagram, label: 'Instagram' },
    ],
  },
  {
    titel: 'Rechtliches',
    links: [
      { href: '/kontakt/', label: 'Kontakt' },
      { href: '/impressum/', label: 'Impressum' },
      { href: '/datenschutz/', label: 'Datenschutz' },
      { href: '/videoueberwachung/', label: 'Videoüberwachung' },
    ],
  },
];
const jahr = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__brand">
    <Image src={logo} alt="SKV Eglosheim – Tennis & Padel" class="site-footer__logo" />
    <p>{kontakt.strasse}<br />{kontakt.ort}<br />Tel. {kontakt.telefon}</p>
  </div>
  {
    spalten.map((s, i) => (
      <div class="site-footer__col">
        <div class="site-footer__title">{s.titel}</div>
        {s.links.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
        {i === spalten.length - 1 && <div class="site-footer__copy">© {jahr} TA SKV Eglosheim</div>}
      </div>
    ))
  }
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--cream);
    padding: 56px var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) repeat(3, minmax(0, 1fr));
    gap: 40px;
    font-size: 17px;
  }
  .site-footer__brand { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .site-footer__logo { height: 96px; width: auto; display: block; }
  .site-footer__brand p { line-height: 1.6; color: var(--on-dark-muted); }
  .site-footer__col { display: flex; flex-direction: column; gap: 10px; }
  .site-footer__title { font-weight: 600; margin-bottom: 4px; }
  .site-footer__col a { color: var(--on-dark-muted); }
  .site-footer__col a:hover { color: #fff; }
  .site-footer__copy { margin-top: 12px; color: var(--on-dark-faint); }

  @media (max-width: 900px) {
    .site-footer { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .site-footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .site-footer { grid-template-columns: minmax(0, 1fr); }
  }
</style>
