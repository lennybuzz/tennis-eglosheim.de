---
/**
 * Fußzeile nach design.md (Ft1 Mast-headed):
 * großes Logo, Kontakt in einer Zeile, Seitenlinks als eine Reihe,
 * Rechtliches als zweite, leisere Reihe.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo.svg';
import { kontakt, links } from '../lib/inhalte';
import { url } from '../lib/url';

const seiten = [
  { href: url('/verein/'), label: 'Verein' },
  { href: url('/tennis/'), label: 'Tennis' },
  { href: url('/padel/'), label: 'Padel' },
  { href: url('/verein/termine/'), label: 'Termine' },
  { href: url('/verein/ansprechpartner/'), label: 'Ansprechpartner' },
  { href: url('/faq/'), label: 'Häufige Fragen' },
  { href: url('/mitglied-werden/'), label: 'Mitglied werden' },
  { href: links.platzbuchung, label: 'Platz buchen ↗' },
];
const rechtliches = [
  { href: url('/kontakt/'), label: 'Kontakt' },
  { href: url('/impressum/'), label: 'Impressum' },
  { href: url('/datenschutz/'), label: 'Datenschutz' },
  { href: url('/videoueberwachung/'), label: 'Videoüberwachung' },
];
const jahr = new Date().getFullYear();
---

<footer class="site-footer px">
  <div class="mast">
    <Image src={logo} alt="SKV Eglosheim – Tennis & Padel" class="mast__logo" />
    <p class="mast__zeile">
      <span>{kontakt.strasse}, {kontakt.ort}</span>
      {kontakt.telefon && <a href={`tel:${kontakt.telefonLink}`}>{kontakt.telefon}</a>}
      <a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
      <a href={links.instagram}>@{kontakt.instagram}</a>
    </p>
  </div>

  <nav class="seiten" aria-label="Seiten">
    {seiten.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>

  <div class="recht">
    <span>© {jahr} TA SKV Eglosheim</span>
    {rechtliches.map((l) => <a href={l.href}>{l.label}</a>)}
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-paper-2);
    color: var(--color-ink);
    border-top: var(--rule-strong); /* hell, damit das Logo auf seinem vorgesehenen Grund steht */
    padding-block: var(--space-2xl) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .mast { display: flex; align-items: flex-end; gap: var(--space-lg) var(--space-xl); flex-wrap: wrap; }
  .mast__logo { height: clamp(96px, 12vw, 132px); width: auto; display: block; }
  .mast__zeile {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-ink-2);
    padding-bottom: var(--space-2xs);
  }
  .mast__zeile > * { white-space: nowrap; }
  .mast__zeile a { color: var(--color-ink); }
  .mast__zeile a:hover { color: var(--color-accent); }

  .seiten {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    padding-top: var(--space-md);
    border-top: var(--rule);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .seiten a { color: var(--color-ink); white-space: nowrap; }
  .seiten a:hover { color: var(--color-accent); }

  .recht {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-ink-3);
  }
  .recht a { color: var(--color-ink-2); white-space: nowrap; }
  .recht a:hover { color: var(--color-accent); }

  @media (max-width: 560px) {
    .mast__zeile { flex-direction: column; gap: var(--space-3xs); }
    .mast__zeile > * { white-space: normal; overflow-wrap: anywhere; }
    .seiten { font-size: var(--text-md); gap: var(--space-xs) var(--space-md); }
  }
</style>
