---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Bild from '../components/Bild.astro';
import inhalte, { links } from '../lib/inhalte';

const { spielbetrieb, training } = inhalte;
---

<BaseLayout title="Tennis" description="Tennis beim SKV Eglosheim: Mannschaften im WTB-Spielbetrieb, Training für Kinder, Jugendliche und Erwachsene, Platzbuchung online.">
  <PageIntro eyebrow="Tennis" titel="Kraft, Präzision und ein Platz für jeden">
    Tennis ist eine faszinierende und dynamische Sportart, die sowohl Kraft als auch Präzision erfordert. Gespielt wird es
    auf verschiedenen Belägen wie Sand, Rasen oder Hartplatz – allein (Einzel) oder im Team (Doppel). Ziel ist es, den Ball
    so über das Netz ins gegnerische Feld zu spielen, dass der Gegner ihn nicht mehr regelgerecht zurückschlagen kann.
  </PageIntro>

  <section class="split px" style="padding-bottom:56px">
    <p class="body">
      Tennis fördert nicht nur die körperliche Fitness, sondern auch Konzentration, Reaktionsgeschwindigkeit und
      strategisches Denken. Egal, ob als Hobbyspieler oder Profi – dieser Sport begeistert Menschen aller Altersklassen
      weltweit. Mit etwas Übung und der richtigen Technik kann jeder die Faszination des Tennissports erleben!
    </p>
    <Bild platzhalter="Foto Tennisplatz" hoehe="360px" />
  </section>

  <section id="spielbetrieb" class="split band-sand px spiel">
    <div class="stack">
      <h2 class="h2 h2--sm">Spielbetrieb</h2>
      <p class="body">
        Die Tennisabteilung des SKV Eglosheim nimmt aktiv am Mannschaftsspielbetrieb des Württembergischen Tennis-Bunds
        (WTB) teil und stellt dabei mehrere Teams in unterschiedlichen Alters- und Leistungsklassen.
      </p>
      <p class="spiel__klein">
        Aktuelle Informationen zu Spielplänen, Ergebnissen und Tabellenständen finden Sie auf der offiziellen WTB-Webseite
        unter dem Vereinsprofil der TA SKV Eglosheim.
      </p>
      <a href={links.wtb} class="btn btn--primary" style="align-self:flex-start">Ergebnisse beim WTB ansehen</a>
    </div>
    <div class="stack" style="--stack-gap:16px">
      <div class="eyebrow eyebrow--grey">Gemeldete Mannschaften · {spielbetrieb.saison}</div>
      <div class="teams">
        {
          spielbetrieb.teams.map((t) => (
            <div class="teams__zeile">
              <span class="teams__name">{t.name}</span>
              <span class="teams__liga">{t.liga}</span>
            </div>
          ))
        }
      </div>
      {spielbetrieb.winterHinweis && <p class="spiel__klein">{spielbetrieb.winterHinweis}</p>}
    </div>
  </section>

  <section id="training" class="px grid grid-3" style="padding-block:64px">
    <div class="card">
      <span class="card__kicker">Training</span>
      <span class="card__title">{training.zeitraum}</span>
      <p class="card__text">{training.hinweis}</p>
      <div class="zeiten">
        {
          training.zeiten.map((z) => (
            <div class="zeiten__zeile">
              <span class="zeiten__gruppe">{z.gruppe}</span>
              <span>{z.zeit}</span>
            </div>
          ))
        }
      </div>
    </div>
    <a href={links.platzbuchung} class="card">
      <span class="card__kicker">Platz buchen</span>
      <span class="card__title">Online reservieren</span>
      <span class="card__text">Für Mitglieder kostenfrei über eBuSy.</span>
    </a>
    <a href="/mitglied-werden/" class="card card--dark">
      <span class="card__kicker">Mitmachen</span>
      <span class="card__title">Werde jetzt Mitglied</span>
      <span class="card__text">Beiträge und Anmeldung auf einen Blick.</span>
    </a>
  </section>
</BaseLayout>

<style>
  .spiel { padding-block: 56px; align-items: start; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
  .spiel__klein { font-size: 17px; line-height: 1.6; color: var(--muted); }
  .teams { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .teams__zeile { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; padding: 20px 24px; border-bottom: 1px solid var(--line-soft); }
  .teams__zeile:last-child { border-bottom: 0; }
  .teams__name { font-size: 19px; font-weight: 600; }
  .teams__liga { color: var(--muted); text-align: right; }
  .zeiten { display: flex; flex-direction: column; gap: 6px; margin-top: 6px; }
  .zeiten__zeile { display: flex; justify-content: space-between; gap: 16px; font-size: 16px; border-top: 1px solid var(--line-soft); padding-top: 6px; color: var(--muted); }
  .zeiten__zeile span:last-child { text-align: right; }
  .zeiten__gruppe { font-weight: 600; color: var(--ink); }
</style>
