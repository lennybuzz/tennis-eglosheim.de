---
import BaseLayout from '../layouts/BaseLayout.astro';
import inhalte, { kontakt, links, mannschaften, minBeitrag } from '../lib/inhalte';

const { anlage, buchung, mitgliedschaftBedingungen, mitglieder, training, spielbetrieb, termine, sommerSpecial, timeline } =
  inhalte;
const tarifGruppe = inhalte.beitraege.gruppen[0];
const chronik = [...timeline].reverse();
---

<BaseLayout>
  <!-- Kleiner Hero -->
  <section class="hero px">
    <div class="hero__text">
      <h1>Tennis &amp; Padel für alle</h1>
      <p class="hero__lead">
        {`${anlage.tennisplaetze} Sandplätze und ${anlage.padelplaetze} Padelplätze mit Flutlicht`} in Ludwigsburg-Eglosheim.
        Für Mitglieder kostenfrei, für Gäste stundenweise buchbar.
      </p>
      <div class="btn-row">
        <a href={links.platzbuchung} class="btn btn--accent">Platz buchen <span aria-hidden="true">↗</span></a>
        <a href="/mitglied-werden/" class="btn btn--outline-light">Mitglied werden</a>
      </div>
    </div>
    <dl class="hero__fakten">
      <div>
        <dt>Anlage</dt>
        <dd>{kontakt.strasse}<br />{kontakt.ort}</dd>
      </div>
      <div>
        <dt>Spielzeiten</dt>
        <dd>
          {
            buchung.spielzeiten.map((s, i) => (
              <>
                {i > 0 && <br />}
                {s.tage}, {s.zeit}
              </>
            ))
          }
        </dd>
      </div>
    </dl>
  </section>

  <!-- Das Wichtigste: vier Fragen -->
  <section class="verzeichnis px" aria-label="Das Wichtigste">
    <p class="verzeichnis__stand">Das Wichtigste</p>

    <ol class="index">
      <li class="eintrag" id="buchen">
        <h2 class="eintrag__frage">Wo kann ich buchen?</h2>
        <div class="eintrag__info">
          <p class="info__lead">
            Online über {buchung.system}: <a href={links.platzbuchung}>{buchung.adresseAnzeige}</a>
          </p>
          <div class="raster raster--2">
            <dl class="liste">
              <div>
                <dt>Tennis</dt>
                <dd>{anlage.tennisplaetze} Sandplätze ({anlage.tennisplaetze_belag})</dd>
              </div>
              <div>
                <dt>Padel</dt>
                <dd>{anlage.padelplaetze} Plätze. {anlage.padel_hinweis}</dd>
              </div>
            </dl>
            <div class="spalte">
              <dl class="liste">
                {
                  buchung.spielzeiten.map((s) => (
                    <div>
                      <dt>{s.tage}</dt>
                      <dd class="zahl">{s.zeit}</dd>
                    </div>
                  ))
                }
              </dl>
              <p class="info__klein">{buchung.spielzeitenHinweis}</p>
            </div>
          </div>
          <a href={links.platzbuchung} class="btn btn--primary info__cta">Zur Platzbuchung <span aria-hidden="true">↗</span></a>
        </div>
      </li>

      <li class="eintrag" id="so-gehts">
        <h2 class="eintrag__frage">Wie buche ich?</h2>
        <div class="eintrag__info">
          <ol class="schritte">
            {
              buchung.schritte.map((s, i) => (
                <li>
                  <span class="schritte__nr" aria-hidden="true">{i + 1}</span>
                  <div>
                    <p class="schritte__titel">{s.titel}</p>
                    <p>{s.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="raster raster--2">
            <div class="spalte">
              <p class="spalte__titel">Schläger leihen</p>
              <p>{buchung.leihePadel} {buchung.leiheTennis}</p>
            </div>
            <div class="spalte">
              <table class="tabelle">
                <caption>Stornieren</caption>
                <tbody>
                  {
                    buchung.stornierung.map((s) => (
                      <tr>
                        <th scope="row">{s.frist}</th>
                        <td>{s.erstattung}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
              <p class="info__klein">{buchung.stornierungHinweis}</p>
            </div>
          </div>
        </div>
      </li>

      <li class="eintrag" id="beitraege">
        <h2 class="eintrag__frage">Was kostet eine Mitgliedschaft?</h2>
        <div class="eintrag__info">
          <p class="info__lead">
            Ab <span class="zahl">{minBeitrag()} €</span> im Jahr. Dafür spielst du auf allen Plätzen kostenfrei.
          </p>
          <div class="raster raster--2">
            <div class="spalte">
              {
                sommerSpecial.aktiv && (
                  <p class="info__hinweis">
                    <strong>{sommerSpecial.titel}:</strong> {sommerSpecial.kurz}
                  </p>
                )
              }
              <table class="tabelle tabelle--preise">
                <caption>{tarifGruppe.titel}</caption>
                <tbody>
                  {
                    tarifGruppe.tarife.map((t) => (
                      <tr>
                        <th scope="row">
                          {t.name} <span class="tabelle__zusatz">{t.zusatz}</span>
                        </th>
                        <td>{t.preis}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
              <p class="info__klein">
                <a href="/mitglied-werden/#beitraege">Tarife ohne Arbeitsdienst und für Kinder ab {minBeitrag()} €</a>
              </p>
            </div>

            <table class="tabelle tabelle--gast">
              <caption>Zum Vergleich: ohne Mitgliedschaft, pro Stunde</caption>
              <thead>
                <tr>
                  <th scope="col">Platz und Zeit</th>
                  <th scope="col">Gäste</th>
                  <th scope="col">SKV-Mitglieder<span class="tabelle__zusatz"> andere Abteilungen</span></th>
                </tr>
              </thead>
              <tbody>
                {
                  buchung.preise.map((p) => (
                    <tr>
                      <th scope="row">
                        {p.platz} <span class="tabelle__zusatz">{p.zeitraum}</span>
                      </th>
                      <td>{p.gast}</td>
                      <td>{p.skv}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </li>

      <li class="eintrag" id="bedingungen">
        <h2 class="eintrag__frage">Welche Bedingungen gelten?</h2>
        <div class="eintrag__info">
          <dl class="bedingungen">
            {
              mitgliedschaftBedingungen.punkte.map((b) => (
                <div>
                  <dt>{b.titel}</dt>
                  <dd>{b.text}</dd>
                </div>
              ))
            }
            {
              sommerSpecial.aktiv && (
                <div>
                  <dt>{sommerSpecial.titel}</dt>
                  <dd>{sommerSpecial.text}</dd>
                </div>
              )
            }
          </dl>
          <p class="info__links">
            <a href="/anmeldung/" class="btn btn--primary">Online anmelden</a>
            <a href="/faq/#mitgliedschaft" class="link-arrow">Alle Fragen zur Mitgliedschaft →</a>
          </p>
        </div>
      </li>
    </ol>
  </section>

  <!-- Verzeichnis: alles Weitere -->
  <section id="aktuell" class="verzeichnis verzeichnis--weiter px" aria-label="Außerdem im Verein">
    <p class="verzeichnis__stand">Außerdem · {spielbetrieb.saison}</p>

    <ol class="index index--raster">
      <li class="eintrag" id="training">
        <h2 class="eintrag__titel">
          <a href="/tennis/#training">Training <span class="pfeil" aria-hidden="true">→</span></a>
        </h2>
        <div class="eintrag__info">
          <p class="info__lead">{training.zeitraum}</p>
          <dl class="liste">
            {
              training.zeiten.map((z) => (
                <div>
                  <dt>{z.gruppe}</dt>
                  <dd>{z.zeit}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </li>

      <li class="eintrag">
        <h2 class="eintrag__titel">
          <a href={links.wtb}>Mannschaften <span class="pfeil" aria-hidden="true">↗</span></a>
        </h2>
        <div class="eintrag__info">
          <p class="info__lead">{spielbetrieb.saison} im WTB</p>
          {
            mannschaften.length > 0 ? (
              <dl class="liste">
                {mannschaften.map((t) => (
                  <div>
                    <dt>{t.name}</dt>
                    <dd>{t.liga}</dd>
                  </div>
                ))}
              </dl>
            ) : (
              <p>{spielbetrieb.hinweisOhneTeams}</p>
            )
          }
        </div>
      </li>

      <li class="eintrag">
        <h2 class="eintrag__titel">
          <a href="/verein/termine/">Termine <span class="pfeil" aria-hidden="true">→</span></a>
        </h2>
        <div class="eintrag__info">
          <dl class="liste">
            {
              termine.slice(0, 3).map((t) => (
                <div>
                  <dt>{t.titel}</dt>
                  <dd>{t.datum}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </li>

      <li class="eintrag">
        <h2 class="eintrag__titel">
          <a href="/padel/">Padel <span class="pfeil" aria-hidden="true">→</span></a>
        </h2>
        <div class="eintrag__info">
          <p class="info__lead">Seit Juli 2025, die ersten Padelplätze in Ludwigsburg</p>
          <p>
            {anlage.padelplaetze} Outdoor-Plätze mit Flutlicht, offen für Mitglieder und Gäste. Schläger leihst du direkt bei der
            Buchung.
          </p>
        </div>
      </li>

      <li class="eintrag">
        <h2 class="eintrag__titel">
          <a href="/verein/">Der Verein <span class="pfeil" aria-hidden="true">→</span></a>
        </h2>
        <div class="eintrag__info">
          <p class="info__lead"><span class="zahl">{mitglieder.anzahl}</span> Mitglieder, Stand {mitglieder.stand}</p>
          <p>
            Aus allen Gesellschaftsschichten und Altersstufen – aktiv in der Mannschaft oder gemütlich auf der
            Sonnenterrasse. Persönliche Atmosphäre statt Anonymität, hier findet jeder schnell Anschluss.
          </p>
          <p class="info__klein"><a href="/verein/ansprechpartner/">Ansprechpartner</a> · <a href="/faq/">Häufige Fragen</a></p>
        </div>
      </li>

      <li class="eintrag">
        <h2 class="eintrag__titel">
          <a href="/kontakt/">Kontakt <span class="pfeil" aria-hidden="true">→</span></a>
        </h2>
        <div class="eintrag__info">
          <p class="info__lead">{kontakt.strasse}, {kontakt.ort}</p>
          <p class="kontakt">
            {kontakt.telefon && <a href={`tel:${kontakt.telefonLink}`}>{kontakt.telefon}</a>}
            <a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
            <a href={links.instagram}>@{kontakt.instagram}</a>
          </p>
        </div>
      </li>

      <li class="eintrag eintrag--voll">
        <h2 class="eintrag__titel">Chronik</h2>
        <div class="eintrag__info">
          <ol class="chronik">
            {
              chronik.map((e) => (
                <li>
                  <p class="chronik__datum">{e.datum}</p>
                  <div>
                    <p class="chronik__titel">{e.titel}</p>
                    <p class="chronik__text">{e.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </li>
    </ol>
  </section>
</BaseLayout>

<style>
  /* Hallmark · genre: editorial · macrostructure: Index-First (mit kleinem Hero) · design-system: design.md · designed-as-app
   * tone: Fahrplan / Vereinsbrett (warm, direkt, sportlich) · anchor hue: 28 (Vereinsrot) · Formen: eckig (3 / 2 px)
   * nav: N12 Banner + Leiste · footer: Ft1 Mast-headed · enrichment: none (typography only)
   * pre-emit critique: P5 H5 E4 S5 R4 V4
   */

  /* ---------- Kleiner Hero ---------- */
  .hero {
    background: var(--color-ink);
    color: var(--color-on-dark);
    padding-block: var(--space-xl) var(--space-2xl);
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-lg) var(--space-xl);
    align-items: end;
  }
  .hero__text { display: flex; flex-direction: column; gap: var(--space-sm); }
  .hero h1 {
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .hero__lead { max-width: 56ch; font-size: var(--text-md); line-height: 1.55; color: var(--color-on-dark-2); text-wrap: pretty; }
  .hero .btn-row { margin-top: var(--space-2xs); }
  .hero .btn--outline-light { border-color: var(--color-on-dark); }
  .hero .btn--outline-light:hover { background: var(--color-on-dark); color: var(--color-ink); }

  .hero__fakten { margin: 0; display: flex; flex-direction: column; border-top: 1px solid var(--color-dark-rule); }
  .hero__fakten div { display: flex; flex-direction: column; gap: 2px; padding-block: var(--space-xs); border-bottom: 1px solid var(--color-dark-rule-2); }
  .hero__fakten dt { font-size: var(--text-sm); font-weight: 600; color: var(--color-accent-soft); }
  .hero__fakten dd { margin: 0; line-height: 1.5; font-variant-numeric: tabular-nums; }

  /* ---------- Verzeichnis ---------- */
  .verzeichnis { padding-block: var(--space-xl) var(--space-xl); }
  .verzeichnis--weiter { padding-block: var(--space-lg) var(--space-3xl); }
  .verzeichnis__stand {
    padding-bottom: var(--space-xs);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-3);
  }

  .index { list-style: none; margin: 0; padding: 0; border-top: var(--rule-strong); }

  .eintrag {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-sm) var(--space-xl);
    padding-block: var(--space-lg);
    border-bottom: var(--rule);
  }

  /* Die vier Fragen: Überschrift, kein Link – darf umbrechen */
  .eintrag__frage {
    font-size: clamp(1.625rem, 1.1rem + 2vw, 2.625rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
    overflow-wrap: normal;
  }

  /* Verzeichnis-Einträge: Link, bricht nie um */
  .eintrag__titel {
    font-size: clamp(1.625rem, 1.1rem + 2vw, 2.625rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    overflow-wrap: normal;
  }
  .eintrag__titel a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .eintrag__titel a:hover { color: var(--color-accent); }

  .pfeil {
    font-size: 0.6em;
    color: var(--color-ink-3);
    transition: transform var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out);
  }
  .eintrag__titel a:hover .pfeil,
  .eintrag__titel a:focus-visible .pfeil { transform: translateX(4px); color: currentColor; }

  .eintrag__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-top: var(--space-3xs);
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--color-ink-2);
    max-width: 64ch;
    min-width: 0;
  }
  .info__lead {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
  }
  .info__lead a { overflow-wrap: anywhere; }
  .info__hinweis strong { color: var(--color-accent); }
  .info__klein { font-size: var(--text-sm); color: var(--color-ink-3); }
  .info__cta { align-self: flex-start; }
  .info__links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-md); padding-top: var(--space-2xs); }
  .zahl { font-variant-numeric: tabular-nums; }

  /* Spaltengruppen innerhalb einer Antwort: schmal untereinander, breit nebeneinander */
  .raster, .spalte { display: flex; flex-direction: column; gap: var(--space-sm); min-width: 0; }
  .spalte__titel { font-weight: 600; color: var(--color-ink); margin-bottom: calc(var(--space-sm) * -0.75); }

  .kontakt { display: flex; flex-wrap: wrap; gap: var(--space-3xs) var(--space-md); }
  .kontakt a { overflow-wrap: anywhere; }

  /* Chronik: neueste zuerst */
  .chronik { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .chronik li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-sm);
    padding-block: var(--space-xs);
    border-top: 1px solid var(--color-rule-soft);
  }
  .chronik li:first-child .chronik__datum { color: var(--color-accent); }
  .chronik__datum { font-size: var(--text-sm); font-weight: 600; color: var(--color-ink-3); font-variant-numeric: tabular-nums; padding-top: 2px; }
  .chronik__titel { font-weight: 600; color: var(--color-ink); }
  .chronik__text { font-size: var(--text-sm); }

  /* ---------- Breite Bildschirme (16:9): Fläche nutzen ---------- */
  @media (min-width: 1200px) {
    .eintrag { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); }
    .eintrag__info { max-width: none; }

    .raster--2 {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-sm) var(--space-xl);
      align-items: start;
    }

    /* Buchungsschritte nebeneinander */
    .schritte { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-lg); }
    .schritte li { grid-template-columns: minmax(0, 1fr); align-content: start; gap: var(--space-2xs); }

    /* Bedingungen in drei Spalten */
    .bedingungen { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-xl); }
    .bedingungen div:last-child { border-bottom: 0; }

    /* „Außerdem“: drei Spalten, Titel über dem Inhalt */
    .index--raster {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--space-xl);
      border-bottom: var(--rule);
    }
    .index--raster .eintrag {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      border-bottom: 0;
      border-top: var(--rule);
    }
    .index--raster .eintrag:nth-child(-n + 3) { border-top: 0; }
    .index--raster .eintrag__info { max-width: 64ch; }
    .index--raster .eintrag--voll { grid-column: 1 / -1; }
    .index--raster .eintrag--voll .eintrag__info { max-width: none; }

    /* Chronik als Zeitleiste über die volle Breite */
    .eintrag--voll .chronik { flex-direction: row-reverse; gap: var(--space-lg); } /* älteste links, neueste rechts */
    .eintrag--voll .chronik li { flex: 1 1 0; grid-template-columns: minmax(0, 1fr); gap: var(--space-3xs); border-top: var(--rule-strong); }
    .eintrag--voll .chronik li:first-child { border-top-color: var(--color-accent); }
  }

  @media (min-width: 1600px) {
    .raster--2 { column-gap: var(--space-2xl); }
    .hero { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); }
  }

  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); align-items: start; }
  }
  @media (max-width: 760px) {
    .hero { padding-block: var(--space-lg) var(--space-xl); }
    .eintrag { grid-template-columns: minmax(0, 1fr); padding-block: var(--space-md); }
    .liste div { flex-direction: column; gap: 2px; }
    .liste dd { text-align: left; }
    .chronik li { grid-template-columns: minmax(0, 1fr); gap: 2px; }
  }
</style>
