---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import inhalte from '../../lib/inhalte';

const { ansprechpartner, kontakt } = inhalte;
---

<BaseLayout
  title="Ansprechpartner"
  description="Abteilungsleitung, Sportwart, Jugendwart, Kassierer und mehr: wer bei der Tennis- und Padelabteilung des SKV Eglosheim wofür zuständig ist."
>
  <PageIntro titel="Melde dich einfach bei uns" pfad={[{ label: 'Verein', href: '/verein/' }, { label: 'Ansprechpartner' }]}>
    Egal ob du direkt beim Probetraining reinschnuppern willst oder erst mal nur ein paar Fragen hast – schreib der
    passenden Person eine kurze Nachricht. Wenn du unsicher bist, geht alles an{' '}
    <a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>, wir leiten weiter.
  </PageIntro>

  <section class="personen px">
    <ul class="personen__liste">
      {
        ansprechpartner.map((p) => (
          <li class="person">
            <div class="person__wer">
              <p class="person__name">{p.name}</p>
              <p class="person__rolle">{p.rolle}</p>
            </div>
            <ul class="person__aufgaben">
              {p.aufgaben.map((a) => (
                <li>{a}</li>
              ))}
            </ul>
            <a href={`mailto:${p.email}`} class="person__mail">
              {p.email}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  /* Hallmark · genre: editorial · macrostructure: Long Document (Liste) · design-system: design.md · designed-as-app
   * tone: Vereinsbrett · anchor hue: 28 · Formen eckig · enrichment: none
   * pre-emit critique: P4 H5 E4 S5 R5 V4
   */
  .personen { padding-block: var(--space-sm) var(--space-3xl); }
  .personen__liste { list-style: none; margin: 0; padding: 0; border-top: var(--rule-strong); }
  .person {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr) minmax(0, 4fr);
    gap: var(--space-2xs) var(--space-xl);
    align-items: baseline;
    padding-block: var(--space-md);
    border-bottom: var(--rule);
  }
  .person__name { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; line-height: 1.2; }
  .person__rolle { margin-top: 2px; font-weight: 600; color: var(--color-accent); }
  .person__aufgaben { list-style: none; margin: 0; padding: 0; color: var(--color-ink-2); line-height: 1.55; }
  .person__mail { font-weight: 600; overflow-wrap: anywhere; justify-self: end; text-align: right; }

  @media (max-width: 900px) {
    .person { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .person__mail { grid-column: 1 / -1; justify-self: start; text-align: left; }
  }
  @media (max-width: 560px) {
    .person { grid-template-columns: minmax(0, 1fr); gap: var(--space-2xs); }
  }
</style>
