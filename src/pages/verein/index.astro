---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Bild from '../../components/Bild.astro';
import vereinAnlage from '../../assets/bilder/verein-anlage.jpg';
import vereinPadel from '../../assets/bilder/verein-padel.jpg';
import vereinLuftbild from '../../assets/bilder/verein-luftbild.jpg';
import vereinGastro from '../../assets/bilder/verein-gastro.jpg';
import vereinClubhausPlaetze from '../../assets/bilder/verein-clubhaus-plaetze.jpg';
import inhalte from '../../lib/inhalte';
import { url } from '../../lib/url';

const { anlage, mitglieder, kontakt, buchung } = inhalte;
---

<BaseLayout
  title="Der Verein"
  description="Tennis & Padel für alle Altersstufen: unsere Anlage in Ludwigsburg-Eglosheim mit Sandplätzen, Padelplätzen, Ballwand, Fitnessbereich und Clubhaus."
>
  <PageIntro titel="Wir sind ein Verein für alle Altersstufen">
    Unsere Mitglieder kommen aus allen Gesellschaftsschichten und Altersstufen. Dank unserer Größe und der persönlichen
    Atmosphäre findest du als neues Mitglied sehr schnell Anschluss und Spielpartner.
  </PageIntro>

  <div class="dokument px">
    <article class="dokument__text">
      <h2>Unser Tennisverein</h2>
      <p>
        Du möchtest aktiv in einer Mannschaft spielen oder im Hobbybereich einfach Spaß am Tennis haben? In unseren Damen-
        und Herrenmannschaften findet jeder seinen Platz.
      </p>
      <p>
        Unsere Anlage liegt ruhig und idyllisch. Von der Terrasse aus siehst du alle Plätze und kannst spannende Matches
        verfolgen. Das große Clubhaus hat einen von den Mitgliedern betriebenen Gastronomiebereich, der zum gemütlichen
        Beisammensein einlädt, und einen gut ausgestatteten Jugendraum. Für die Kleinsten gibt es einen Außenbereich mit
        Sandkasten.
      </p>

      <h2>Was unsere Anlage bietet</h2>
      <p>
        Wir haben <strong>{anlage.tennisplaetze} Sandplätze</strong> – bei unserer Mitgliederzahl reicht die
        Kapazität aber völlig aus, Wartezeiten gibt es so gut wie nie. Seit Juli 2025 kommen{' '}
        <strong>{anlage.padelplaetze} Padelplätze</strong> mit Flutlicht dazu, buchbar für Mitglieder und Gäste.
      </p>
      <p>
        An der <strong>Ballwand</strong> spielst du dich vor dem Match warm oder trainierst ohne Spielpartner. Unser{' '}
        <strong>Outdoor-Fitnessbereich</strong> bietet viele Möglichkeiten, dich aufzuwärmen, Verletzungen vorzubeugen
        oder mit Therabändern den ganzen Körper zu trainieren.
      </p>
      <p>
        Jedes Mitglied erhält einen <strong>eigenen digitalen Schlüssel</strong> und hat damit jederzeit Zutritt zur Anlage.
      </p>

      <h2>Mitmachen</h2>
      <p>
        Am einfachsten lernst du uns bei einem Probetraining kennen. Wer bei uns wofür zuständig ist, steht bei den
        Ansprechpartnern; alle Vereinstermine findest du im Kalender.
      </p>
      <p class="weiter">
        <a href={url('/mitglied-werden/')} class="link-arrow">Mitglied werden →</a>
        <a href={url('/verein/ansprechpartner/')} class="link-arrow">Ansprechpartner →</a>
        <a href={url('/verein/termine/')} class="link-arrow">Termine →</a>
        <a href={url('/padel/')} class="link-arrow">Padel →</a>
      </p>
    </article>

    <aside class="dokument__rand" aria-label="Der Verein in Zahlen">
      <Bild bild={vereinPadel} alt="Luftaufnahme der Padelplätze mit Flutlicht" platzhalter="Foto der Padelplätze" hoehe="auto" sizes="(max-width: 900px) 100vw, 30vw" />
      <Bild bild={vereinAnlage} alt="Clubhaus und Tennisplätze der Anlage" platzhalter="Foto der Anlage" hoehe="auto" sizes="(max-width: 900px) 100vw, 30vw" />
      <table class="tabelle">
        <caption>Auf einen Blick</caption>
        <tbody>
          <tr>
            <th scope="row">Mitglieder</th>
            <td>{mitglieder.anzahl} <span class="tabelle__zusatz">Stand {mitglieder.stand}</span></td>
          </tr>
          <tr>
            <th scope="row">Tennis</th>
            <td>{anlage.tennisplaetze} Sandplätze</td>
          </tr>
          <tr>
            <th scope="row">Padel</th>
            <td>{anlage.padelplaetze} Plätze mit Flutlicht</td>
          </tr>
          <tr>
            <th scope="row">Spielzeiten</th>
            <td>
              {
                buchung.spielzeiten.map((s, i) => (
                  <>
                    {i > 0 && <br />}
                    {s.tage.replace('Montag bis Samstag', 'Mo–Sa').replace('Sonntag', 'So')} {s.zeit}
                  </>
                ))
              }
            </td>
          </tr>
          <tr>
            <th scope="row">Anlage</th>
            <td>{kontakt.strasse}<br />{kontakt.ort}</td>
          </tr>
        </tbody>
      </table>
    </aside>
  </div>

  <section class="fotos px" aria-label="Fotos der Anlage">
    <figure class="fotos__gross">
      <Bild bild={vereinLuftbild} alt="Luftaufnahme der Tennisplätze mit Clubhaus" platzhalter="Luftaufnahme der Anlage" hoehe="auto" sizes="(max-width: 900px) 100vw, 1400px" />
    </figure>
    <div class="fotos__reihe">
      <figure>
        <Bild bild={vereinGastro} alt="Gastronomiebereich im Clubhaus" platzhalter="Gastronomiebereich" hoehe="auto" sizes="(max-width: 900px) 100vw, 50vw" />
      </figure>
      <figure>
        <Bild bild={vereinClubhausPlaetze} alt="Clubhaus mit Blick auf Platz 2 und 3" platzhalter="Clubhaus mit Plätzen" hoehe="auto" sizes="(max-width: 900px) 100vw, 50vw" />
      </figure>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hallmark · genre: editorial · macrostructure: Long Document · design-system: design.md · designed-as-app
   * tone: Vereinsbrett · anchor hue: 28 · Formen eckig · enrichment: ein Foto (Platzhalter bis echtes Bild)
   * pre-emit critique: P4 H4 E4 S4 R5 V4
   */
  .dokument {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-xl) var(--space-2xl);
    align-items: start;
    padding-block: var(--space-md) var(--space-3xl);
  }
  .dokument__text { grid-column: 1; grid-row: 1; display: flex; flex-direction: column; gap: var(--space-sm); }
  .dokument__text h2 {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: var(--rule);
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .dokument__text h2:first-child { margin-top: 0; border-top: var(--rule-strong); }
  .dokument__text p { font-size: var(--text-md); line-height: 1.7; color: var(--color-ink-2); text-wrap: pretty; }
  .dokument__text strong { color: var(--color-ink); font-weight: 600; }
  .weiter { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-md); }

  .dokument__rand {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .dokument__rand .tabelle td { text-align: right; }
  .dokument__rand .tabelle__zusatz { display: block; }

  .fotos {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-block: 0 var(--space-3xl);
  }
  .fotos figure { margin: 0; min-width: 0; }
  .fotos__reihe {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  @media (max-width: 900px) {
    .dokument { grid-template-columns: minmax(0, 1fr); }
    .dokument__text, .dokument__rand { grid-column: 1; grid-row: auto; }
    .fotos__reihe { grid-template-columns: minmax(0, 1fr); }
  }
</style>
