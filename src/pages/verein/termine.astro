---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Einbettung from '../../components/Einbettung.astro';
import inhalte, { links } from '../../lib/inhalte';
import { url } from '../../lib/url';

const { termine } = inhalte;
---

<BaseLayout title="Termine" description="Alle Vereinstermine der Tennis- und Padelabteilung des SKV Eglosheim im ClubDesk-Kalender.">
  <PageIntro titel="Termine im Verein" pfad={[{ label: 'Verein', href: url('/verein/') }, { label: 'Termine' }]}>
    Die wichtigsten Termine stehen hier. Alle Vereinstermine pflegen wir im ClubDesk-Kalender – du kannst ihn unten laden,
    er ist immer aktuell.
  </PageIntro>

  <section class="termine px">
    <table class="tabelle">
      <caption>Demnächst</caption>
      <tbody>
        {
          termine.map((t) => (
            <tr>
              <th scope="row">{t.titel}</th>
              <td>{t.datum}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="kalender px">
    <Einbettung
      src={links.clubdeskTermine}
      titel="Termine im ClubDesk-Kalender"
      anbieter="ClubDesk"
      hinweis="Dabei wird deine IP-Adresse an ClubDesk übertragen, und ClubDesk speichert ein Cookie für die Spracheinstellung."
      knopf="Kalender laden"
      hoehe="900px"
      platzhalterHoehe="320px"
    />
    <p class="hinweis">
      Lieber direkt bei ClubDesk? <a href={links.clubdeskTermine} class="link-arrow">Termine bei ClubDesk öffnen ↗</a>
    </p>
  </section>
</BaseLayout>

<style>
  /* Hallmark · genre: editorial · macrostructure: Long Document · design-system: design.md · designed-as-app
   * tone: Vereinsbrett · anchor hue: 28 · Formen eckig · enrichment: none
   */
  .termine { padding-block: var(--space-sm) var(--space-xl); max-width: calc(72ch + 2 * var(--gutter)); }
  .kalender { padding-bottom: var(--space-3xl); display: flex; flex-direction: column; gap: var(--space-sm); }
  .hinweis { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-sm); align-items: baseline; color: var(--color-ink-2); }
</style>
