---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import inhalte, { mitLinks } from '../lib/inhalte';

const gruppen = inhalte.faq;
const gesamt = gruppen.reduce((n, g) => n + g.fragen.length, 0);
---

<BaseLayout title="Häufige Fragen" description="Antworten zu Mitgliedschaft, Beiträgen, Arbeitsstunden, Platzbuchung, Training und Padel beim SKV Eglosheim.">
  <PageIntro titel="Alles, was vor dem ersten Ballwechsel geklärt sein sollte" breite="960px">
    Mitgliedschaft, Beiträge, Arbeitsstunden, Platzbuchung, Training und Padel. Such nach einem Stichwort oder spring über
    die Themenliste direkt in ein Thema.
    <div slot="extra" class="suche">
      <label for="faq-suche" class="visually-hidden">Fragen durchsuchen</label>
      <input id="faq-suche" type="search" placeholder="Stichwort suchen, z. B. Arbeitsstunden" autocomplete="off" />
      <div class="suche__treffer" aria-live="polite" data-treffer>{gesamt} Fragen</div>
    </div>
  </PageIntro>

  <section class="faq px">
    <aside class="index">
      <p class="index__titel">Themen</p>
      {
        gruppen.map((g) => (
          <a href={`#${g.id}`} class="index__link" data-index={g.id}>
            <span>{g.kategorie}</span>
            <span class="index__anzahl" data-anzahl>{g.fragen.length}</span>
          </a>
        ))
      }
      <button type="button" class="index__alle" data-alle>Alle aufklappen</button>
    </aside>

    <div class="gruppen">
      {
        gruppen.map((g) => (
          <div id={g.id} class="gruppe" data-gruppe>
            <h2>{g.kategorie}</h2>
            {g.fragen.map((f) => (
              <details class="frage" data-frage>
                <summary>
                  <span>{f.frage}</span>
                  <span class="frage__zeichen" aria-hidden="true" />
                </summary>
                <p set:html={mitLinks(f.antwort)} />
              </details>
            ))}
          </div>
        ))
      }
      <div class="leer" data-leer hidden>
        <div class="leer__titel">Dazu haben wir nichts gefunden</div>
        <p>Probier ein anderes Stichwort oder frag uns direkt über das <a href="/kontakt/">Kontaktformular</a>.</p>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="stack" style="--stack-gap:14px">
      <h2 class="cta__titel">Deine Frage ist nicht dabei?</h2>
      <p class="cta__text">
        Schreib uns, wir antworten persönlich und leiten deine Anfrage an die Person weiter, die sie beantworten kann – vom
        Jugendwart bis zum Kassierer.
      </p>
    </div>
    <div class="stack" style="--stack-gap:12px; align-items:flex-start">
      <a href="/kontakt/" class="btn cta__btn">Zum Kontaktformular</a>
      <a href="/verein/ansprechpartner/" class="btn cta__btn cta__btn--ghost">Ansprechpartner ansehen</a>
      <div class="cta__mail">
        oder direkt an&nbsp;<a href={`mailto:${inhalte.kontakt.email}`}>{inhalte.kontakt.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('#faq-suche')!;
  const treffer = document.querySelector<HTMLElement>('[data-treffer]')!;
  const leer = document.querySelector<HTMLElement>('[data-leer]')!;
  const alleBtn = document.querySelector<HTMLButtonElement>('[data-alle]')!;
  const gruppen = [...document.querySelectorAll<HTMLElement>('[data-gruppe]')];
  const fragen = [...document.querySelectorAll<HTMLDetailsElement>('[data-frage]')];
  let alleAuf = false;

  function filtern() {
    const q = input.value.trim().toLowerCase();
    let anzahl = 0;
    for (const g of gruppen) {
      let sichtbar = 0;
      for (const f of g.querySelectorAll<HTMLDetailsElement>('[data-frage]')) {
        const passt = !q || f.textContent!.toLowerCase().includes(q);
        f.hidden = !passt;
        f.open = passt && (alleAuf || !!q);
        if (passt) sichtbar++;
      }
      g.hidden = sichtbar === 0;
      const link = document.querySelector<HTMLElement>(`[data-index="${g.id}"]`)!;
      link.hidden = sichtbar === 0;
      link.querySelector('[data-anzahl]')!.textContent = String(sichtbar);
      anzahl += sichtbar;
    }
    treffer.textContent = q ? `${anzahl} Treffer` : `${anzahl} Fragen`;
    leer.hidden = anzahl > 0;
  }

  input.addEventListener('input', filtern);
  alleBtn.addEventListener('click', () => {
    alleAuf = !alleAuf;
    alleBtn.textContent = alleAuf ? 'Alle zuklappen' : 'Alle aufklappen';
    fragen.forEach((f) => (f.open = alleAuf && !f.hidden));
  });
</script>

<style>
  .suche { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 10px; }
  .suche input {
    font: inherit;
    font-size: 18px;
    color: var(--ink);
    padding: 14px 18px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--color-paper);
    width: 380px;
    max-width: 100%;
  }
  .suche input:focus { border-color: var(--color-accent); }
  .suche__treffer { font-size: 16px; color: var(--muted-2); }

  .faq { padding-block: 8px 72px; display: grid; grid-template-columns: minmax(0, 260px) minmax(0, 1fr); gap: 56px; align-items: start; }

  .index {
    position: sticky;
    top: calc(var(--header-h) + 28px);
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-left: 2px solid var(--line);
    padding-left: 20px;
  }
  .index__link { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; color: var(--ink); font-weight: 500; padding: 8px 0; line-height: 1.35; }
  .index__link:hover { color: var(--red); }
  .index__titel { margin-bottom: var(--space-2xs); font-size: var(--text-sm); font-weight: 600; color: var(--color-ink-3); }
  .index__anzahl { font-size: 14px; color: var(--color-ink-3); font-variant-numeric: tabular-nums; }
  .index__alle {
    margin-top: 18px;
    align-self: flex-start;
    background: none;
    border: 1px solid var(--line-strong);
    color: var(--muted);
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .index__alle:hover { border-color: var(--ink); color: var(--ink); }

  .gruppen { display: flex; flex-direction: column; gap: 48px; min-width: 0; }
  .gruppe { display: flex; flex-direction: column; gap: 6px; }
  .gruppe h2 { margin-bottom: 10px; font-size: 30px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; }

  .frage { border-top: 1px solid var(--line); }
  .frage summary {
    list-style: none;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    cursor: pointer;
    padding: 20px 0;
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.35;
    text-wrap: pretty;
  }
  .frage summary::-webkit-details-marker { display: none; }
  .frage summary:hover { color: var(--red); }
  .frage__zeichen {
    flex: 0 0 auto;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 400;
    color: var(--red);
    line-height: 1;
  }
  .frage__zeichen::before { content: '+'; }
  .frage[open] .frage__zeichen::before { content: '–'; }
  .frage p { max-width: 70ch; padding: 0 70px 24px 0; font-size: 19px; line-height: 1.65; color: var(--muted); text-wrap: pretty; }

  .leer { border: 1px dashed var(--line-strong); border-radius: var(--radius); padding: 40px; display: flex; flex-direction: column; gap: 10px; }
  .leer__titel { font-family: var(--font-display); font-size: 22px; font-weight: 600; }
  .leer p { font-size: 18px; line-height: 1.6; color: var(--muted); }

  @media (max-width: 900px) {
    .faq { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .index { position: static; }
    .frage p { padding-right: 0; }
  }

  .cta {
    margin: 0 var(--gutter) 72px;
    background: var(--color-ink);
    color: var(--color-on-dark);
    border-radius: var(--radius);
    padding: clamp(32px, 5vw, 52px) clamp(24px, 4vw, 48px);
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 44px;
    align-items: center;
  }
  .cta__titel { font-size: clamp(28px, 3vw, 36px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; text-wrap: balance; }
  .cta__text { font-size: 19px; line-height: 1.6; color: var(--color-on-dark-2); text-wrap: pretty; }
  .cta__btn { background: var(--color-accent-2); color: var(--color-on-accent); padding: 15px 26px; }
  .cta__btn:hover { background: var(--color-on-dark); color: var(--color-ink); }
  .cta__btn--ghost { background: none; border-color: var(--color-dark-rule); }
  .cta__mail { color: var(--color-on-dark-3); margin-top: 6px; }
  .cta__mail a { color: var(--color-on-dark); text-decoration: underline; }
  @media (max-width: 900px) {
    .cta { grid-template-columns: minmax(0, 1fr); gap: 28px; }
  }
</style>
