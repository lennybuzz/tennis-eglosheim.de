---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import inhalte, { mitLinks } from '../lib/inhalte';

const gruppen = inhalte.faq;
const gesamt = gruppen.reduce((n, g) => n + g.fragen.length, 0);
---

<BaseLayout title="Häufige Fragen" description="Antworten zu Mitgliedschaft, Beiträgen, Arbeitsstunden, Platzbuchung, Training und Padel beim SKV Eglosheim.">
  <PageIntro titel="Alles, was vor dem ersten Ballwechsel geklärt sein sollte" breite="960px">
    Mitgliedschaft, Beiträge, Arbeitsstunden, Platzbuchung, Training und Padel. Such nach einem Stichwort oder spring über
    die Themenliste direkt in ein Thema.
    <div slot="extra" class="suche">
      <label for="faq-suche" class="visually-hidden">Fragen durchsuchen</label>
      <input id="faq-suche" type="search" placeholder="Stichwort suchen, z. B. Arbeitsstunden" autocomplete="off" />
      <div class="suche__treffer" aria-live="polite" data-treffer>{gesamt} Fragen</div>
    </div>
  </PageIntro>

  <section class="faq px">
    <aside class="index">
      <p class="index__titel">Themen</p>
      {
        gruppen.map((g) => (
          <a href={`#${g.id}`} class="index__link" data-index={g.id}>
            <span>{g.kategorie}</span>
            <span class="index__anzahl" data-anzahl>{g.fragen.length}</span>
          </a>
        ))
      }
      <button type="button" class="index__alle" data-alle>Alle aufklappen</button>
    </aside>

    <div class="gruppen">
      {
        gruppen.map((g) => (
          <div id={g.id} class="gruppe" data-gruppe>
            <h2>{g.kategorie}</h2>
            {g.fragen.map((f) => (
              <details class="frage" data-frage>
                <summary>
                  <span>{f.frage}</span>
                  <span class="frage__zeichen" aria-hidden="true" />
                </summary>
                <p set:html={mitLinks(f.antwort)} />
              </details>
            ))}
          </div>
        ))
      }
      <div class="leer" data-leer hidden>
        <div class="leer__titel">Dazu haben wir nichts gefunden</div>
        <p>Probier ein anderes Stichwort oder frag uns direkt über das <a href="/kontakt/">Kontaktformular</a>.</p>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="cta__text-block">
      <h2 class="cta__titel">Deine Frage ist nicht dabei?</h2>
      <p class="cta__text">
        Schreib uns, wir antworten persönlich und leiten deine Anfrage an die Person weiter, die sie beantworten kann – vom
        Jugendwart bis zum Kassierer.
      </p>
    </div>
    <div class="cta__aktionen">
      <a href="/kontakt/" class="btn cta__btn">Zum Kontaktformular</a>
      <a href="/verein/ansprechpartner/" class="btn cta__btn cta__btn--ghost">Ansprechpartner ansehen</a>
      <p class="cta__mail">
        oder direkt an&nbsp;<a href={`mailto:${inhalte.kontakt.email}`}>{inhalte.kontakt.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('#faq-suche')!;
  const treffer = document.querySelector<HTMLElement>('[data-treffer]')!;
  const leer = document.querySelector<HTMLElement>('[data-leer]')!;
  const alleBtn = document.querySelector<HTMLButtonElement>('[data-alle]')!;
  const gruppen = [...document.querySelectorAll<HTMLElement>('[data-gruppe]')];
  const fragen = [...document.querySelectorAll<HTMLDetailsElement>('[data-frage]')];
  let alleAuf = false;

  function filtern() {
    const q = input.value.trim().toLowerCase();
    let anzahl = 0;
    for (const g of gruppen) {
      let sichtbar = 0;
      for (const f of g.querySelectorAll<HTMLDetailsElement>('[data-frage]')) {
        const passt = !q || f.textContent!.toLowerCase().includes(q);
        f.hidden = !passt;
        f.open = passt && (alleAuf || !!q);
        if (passt) sichtbar++;
      }
      g.hidden = sichtbar === 0;
      const link = document.querySelector<HTMLElement>(`[data-index="${g.id}"]`)!;
      link.hidden = sichtbar === 0;
      link.querySelector('[data-anzahl]')!.textContent = String(sichtbar);
      anzahl += sichtbar;
    }
    treffer.textContent = q ? `${anzahl} Treffer` : `${anzahl} Fragen`;
    leer.hidden = anzahl > 0;
  }

  input.addEventListener('input', filtern);
  alleBtn.addEventListener('click', () => {
    alleAuf = !alleAuf;
    alleBtn.textContent = alleAuf ? 'Alle zuklappen' : 'Alle aufklappen';
    fragen.forEach((f) => (f.open = alleAuf && !f.hidden));
  });
</script>

<style>
  /* Hallmark · genre: editorial · macrostructure: Conversational FAQ · design-system: design.md · designed-as-app
   * tone: Vereinsbrett · anchor hue: 28 · Formen eckig · enrichment: none
   * pre-emit critique: P4 H4 E5 S4 R5 V4
   */

  /* ---------- Suche ---------- */
  .suche { display: flex; align-items: center; gap: var(--space-sm); flex-wrap: wrap; margin-top: var(--space-2xs); }
  .suche input {
    width: 24rem;
    max-width: 100%;
    font: inherit;
    font-size: var(--text-md);
    color: var(--color-ink);
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-sm);
    background: var(--color-paper);
    transition: border-color var(--dur-short) var(--ease-out);
  }
  .suche input::placeholder { color: var(--color-ink-3); opacity: 1; }
  .suche input:hover { border-color: var(--color-ink-3); }
  .suche input:focus { border-color: var(--color-accent); }
  .suche__treffer { font-size: var(--text-sm); color: var(--color-ink-3); font-variant-numeric: tabular-nums; }

  /* ---------- Themenliste + Fragen ---------- */
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: start;
    padding-block: var(--space-2xs) var(--space-2xl);
  }

  .index {
    position: sticky;
    top: calc(var(--header-h) + var(--space-lg));
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding-left: var(--space-md);
    border-left: 2px solid var(--color-rule);
  }
  .index__titel { margin-bottom: var(--space-2xs); font-size: var(--text-sm); font-weight: 600; color: var(--color-ink-3); }
  .index__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs);
    padding-block: var(--space-2xs);
    color: var(--color-ink);
    font-weight: 500;
    line-height: 1.35;
  }
  .index__link:hover { color: var(--color-accent); }
  .index__anzahl { font-size: var(--text-sm); color: var(--color-ink-3); font-variant-numeric: tabular-nums; }
  .index__alle {
    align-self: flex-start;
    margin-top: var(--space-sm);
    padding: var(--space-2xs) var(--space-sm);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-ink-2);
    background: none;
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out);
  }
  .index__alle:hover { border-color: var(--color-ink); color: var(--color-ink); }

  .gruppen { display: flex; flex-direction: column; gap: var(--space-xl); min-width: 0; }
  .gruppe { display: flex; flex-direction: column; }
  .gruppe h2 { margin-bottom: var(--space-sm); font-size: var(--text-2xl); font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; }

  .frage { border-top: var(--rule); }
  .frage:last-child { border-bottom: var(--rule); }
  .frage summary {
    list-style: none;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-md);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.35;
    cursor: pointer;
    text-wrap: pretty;
    transition: color var(--dur-short) var(--ease-out);
  }
  .frage summary::-webkit-details-marker { display: none; }
  .frage summary:hover { color: var(--color-accent); }
  .frage__zeichen {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.875rem;
    height: 1.875rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1;
    color: var(--color-accent);
  }
  .frage__zeichen::before { content: '+'; }
  .frage[open] .frage__zeichen::before { content: '–'; }
  .frage p {
    max-width: 70ch;
    padding: 0 var(--space-2xl) var(--space-md) 0;
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }

  .leer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-xl);
    border: 1px dashed var(--color-rule-strong);
    border-radius: var(--radius);
  }
  .leer__titel { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; }
  .leer p { font-size: var(--text-md); line-height: 1.6; color: var(--color-ink-2); }

  /* ---------- Abschluss: dunkle Fläche (ohne Logo, siehe design.md) ---------- */
  .cta {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: center;
    margin: 0 var(--gutter) var(--space-2xl);
    padding: clamp(2rem, 5vw, 3.25rem) clamp(1.5rem, 4vw, 3rem);
    background: var(--color-ink);
    color: var(--color-on-dark);
    border-radius: var(--radius);
  }
  .cta__text-block { display: flex; flex-direction: column; gap: var(--space-xs); }
  .cta__titel { font-size: var(--text-3xl); font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; text-wrap: balance; }
  .cta__text { max-width: 60ch; font-size: var(--text-md); line-height: 1.6; color: var(--color-on-dark-2); text-wrap: pretty; }
  .cta__aktionen { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-xs); }
  .cta__btn { background: var(--color-accent-2); color: var(--color-on-accent); }
  .cta__btn:hover { background: var(--color-on-dark); color: var(--color-ink); }
  .cta__btn--ghost { background: none; border-color: var(--color-dark-rule); }
  .cta__mail { margin-top: var(--space-3xs); color: var(--color-on-dark-3); }
  .cta__mail a { color: var(--color-on-dark); text-decoration: underline; }
  .cta :focus-visible { outline-color: var(--color-on-dark); }

  @media (max-width: 900px) {
    .faq { grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); }
    .index { position: static; }
    .frage p { padding-right: 0; }
    .cta { grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); }
  }
</style>
