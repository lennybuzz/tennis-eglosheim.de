---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bild from '../components/Bild.astro';
import Tarif from '../components/Tarif.astro';
import inhalte, { links } from '../lib/inhalte';

const { sommerSpecial, beitraege } = inhalte;

const vorteile = [
  {
    titel: 'Schlüssel zur Anlage',
    text: 'Zu Beginn deiner Mitgliedschaft erhältst du einen Schlüssel für Anlage und Clubhaus sowie eine Einführung durch unseren Sport- oder Jugendwart.',
  },
  {
    titel: 'Plätze kostenfrei buchen',
    text: 'Danach kannst du die Plätze jederzeit kostenfrei reservieren und dich mit anderen Mitgliedern zum Spielen verabreden.',
  },
  {
    titel: 'Schläger zum Start',
    text: 'Falls du noch keine eigene Ausrüstung hast, stellen wir dir gerne einen Schläger zur Verfügung.',
  },
  {
    titel: 'Training und Mannschaft',
    text: 'Unser Trainer steht für individuelle oder gruppenbasierte Trainerstunden zur Verfügung. Für den Einstieg in eine Mannschaft helfen Sport- oder Jugendwart weiter.',
  },
];

// PDF-Dateien nach public/dokumente/ legen und hier den Pfad eintragen, z. B. '/dokumente/aufnahmeantrag.pdf'
const dokumente: { titel: string; datei: string | null }[] = [
  { titel: 'Aufnahmeantrag (PDF)', datei: null },
  { titel: 'Abteilungssatzung (PDF)', datei: null },
  { titel: 'Spiel- / Platzordnung (PDF)', datei: null },
];

const fragen = [
  {
    frage: 'Ab welchem Alter kann mein Kind mit dem Tennis anfangen?',
    antwort:
      'Tennis erfreut alle Alterschichten und man kann bereits von klein auf damit beginnen. Mit Hilfe von Methodikbällen und den geeigneten Tennisschlägern können bereits Kinder ab 4 oder 5 Jahren mit den Übungen zur Schulung der Auge-Hand-Koordination starten.',
  },
  {
    frage: 'Wo kann ich meine Schläger bespannen lassen?',
    antwort:
      'Neue Bespannungen für eure Tennisschläger gibts bei unserem Tennistrainer oder in verschiedenen Sportgeschäften in Ludwigsburg. Gerne helfen wir euch weiter.',
  },
  {
    frage: 'Welche Schuhe sind auf dem Sandplatz erlaubt?',
    antwort:
      'Für Sandplätze gibt es für einen festen Stand Tennisschuhe mit speziellem Profil. Wenn ihr euch noch nicht sicher seid, ob Tennis der richtige Sport für euch ist, könnt ihr zum Ausprobieren auch normale Sportschuhe mit wenig Profil benutzen.',
  },
  {
    frage: 'Habt Ihr Leihschläger?',
    antwort: 'Selbstverständlich! Gerne helfen wir auch den richtigen Schläger für dich zu finden.',
  },
];
---

<BaseLayout title="Mitglied werden" description="Mitglied werden beim SKV Eglosheim – Tennis & Padel: Beiträge, Arbeitsdienst, Probetraining und Online-Anmeldung.">
  <section class="hero">
    <div class="hero__text px">
      <div class="eyebrow">Vereinsmitgliedschaft</div>
      <h1>Werde jetzt Mitglied</h1>
      <p class="body">
        Du wolltest schon immer mal den Padel- oder Tennissport ausprobieren und dabei von einem Trainer betreut werden? Oder
        du spielst bereits Tennis oder Padel und möchtest unsere Tennisabteilung kennen lernen? Dann melde dich für ein
        Probetraining an!
      </p>
      <div class="btn-row">
        <a href="/anmeldung/" class="btn btn--primary">Online anmelden</a>
        <a href="#beitraege" class="btn btn--outline">Beiträge ansehen</a>
      </div>
    </div>
    <Bild platzhalter="Foto Training oder Clubhaus" hoehe="420px" radius="0" eager />
  </section>

  {
    sommerSpecial.aktiv && (
      <section class="special px">
        <div class="special__titel">{sommerSpecial.titel}</div>
        <div class="stack" style="--stack-gap:6px">
          <div class="special__kurz">{sommerSpecial.kurz}</div>
          <p class="special__text">{sommerSpecial.text}</p>
        </div>
        <a href="/anmeldung/" class="btn btn--white">Jetzt sichern</a>
      </section>
    )
  }

  <section class="split px" style="padding-block:64px; align-items:start; grid-template-columns:minmax(0,0.9fr) minmax(0,1.1fr)">
    <div class="stack" style="--stack-gap:16px">
      <h2 class="h2">Padel und Tennis kann sich bei uns jeder leisten</h2>
      <p class="body">Ihr habt Lust auf Tennis oder Padel? Wir haben alles, was Ihr für den Start benötigt.</p>
    </div>
    <div class="vorteile">
      {
        vorteile.map((v) => (
          <div class="vorteil">
            <div class="vorteil__titel">{v.titel}</div>
            <p class="vorteil__text">{v.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="beitraege" class="band-sand px beitraege">
    <div class="split" style="align-items:start; grid-template-columns:minmax(0,1fr) minmax(0,1.4fr)">
      <h2 class="h2">Unsere Beiträge</h2>
      <p class="beitraege__hinweis">{beitraege.hinweis}</p>
    </div>
    {
      beitraege.gruppen.map((g) => (
        <div class="stack" style="--stack-gap:16px">
          <h3 class="beitraege__gruppe">{g.titel}</h3>
          <div class="tarife">
            {g.tarife.map((t) => (
              <Tarif {...t} />
            ))}
          </div>
        </div>
      ))
    }
    <div class="btn-row" style="align-items:center; gap:20px; padding-top:8px">
      <a href="/anmeldung/" class="btn btn--primary">Online anmelden</a>
      <span class="muted">Alle Infos zum Hauptverein: <a href={links.hauptverein}>skv-eglosheim.de</a></span>
    </div>
  </section>

  <section id="faq" class="split px" style="padding-block:64px; align-items:start; grid-template-columns:minmax(0,0.9fr) minmax(0,1.1fr)">
    <div class="stack" style="--stack-gap:14px">
      <h2 class="h2">Häufige Fragen</h2>
      <p class="muted" style="font-size:18px; line-height:1.6">
        Falls weitere Fragen aufkommen, nutze bitte das <a href="/kontakt/">Kontaktformular</a> oder schau in unsere{' '}
        <a href="/faq/">ausführlichen FAQ</a>.
      </p>
      <div class="downloads">
        <div class="downloads__titel">Downloads und Dokumente</div>
        {
          dokumente.map((d) =>
            d.datei ? (
              <a href={d.datei}>{d.titel}</a>
            ) : (
              <span class="downloads__folgt">{d.titel} – folgt</span>
            ),
          )
        }
      </div>
    </div>
    <div class="fragen">
      {
        fragen.map((f) => (
          <div class="frage">
            <div class="frage__titel">{f.frage}</div>
            <p class="frage__text">{f.antwort}</p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; }
  .hero__text { padding-block: 56px; display: flex; flex-direction: column; gap: 20px; }
  .hero h1 { font-size: clamp(38px, 4.8vw, 56px); line-height: 1; font-weight: 600; letter-spacing: -0.03em; text-wrap: balance; }
  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .hero__text { padding-block: 40px; }
    .hero :global(.bild) { height: 280px; }
  }

  .special { background: var(--red); color: #fff; padding-block: 36px; display: grid; grid-template-columns: auto 1fr auto; gap: 20px 32px; align-items: center; }
  .special__titel { font-family: var(--font-display); font-size: 15px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }
  .special__kurz { font-family: var(--font-display); font-size: clamp(22px, 2.4vw, 28px); font-weight: 600; line-height: 1.15; }
  .special__text { font-size: 17px; line-height: 1.55; max-width: 820px; color: #FFE7DC; }
  @media (max-width: 900px) {
    .special { grid-template-columns: minmax(0, 1fr); }
    .special .btn { justify-self: start; }
  }

  .vorteile { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .vorteil { display: flex; flex-direction: column; gap: 8px; border-top: 2px solid var(--ink); padding-top: 18px; }
  .vorteil__titel { font-family: var(--font-display); font-size: 21px; font-weight: 600; }
  .vorteil__text { line-height: 1.55; color: var(--muted); }
  @media (max-width: 560px) {
    .vorteile { grid-template-columns: minmax(0, 1fr); }
  }

  .beitraege { padding-block: 64px; display: flex; flex-direction: column; gap: 36px; }
  .beitraege__hinweis { line-height: 1.65; color: var(--muted); text-wrap: pretty; }
  .beitraege__gruppe { font-size: 24px; font-weight: 600; }
  .tarife { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 16px; }

  .downloads { display: flex; flex-direction: column; gap: 10px; margin-top: 12px; }
  .downloads__titel { font-weight: 600; }
  .downloads__folgt { color: var(--muted-2); }

  .fragen { display: flex; flex-direction: column; }
  .frage { border-top: 1px solid var(--line); padding: 22px 0; display: flex; flex-direction: column; gap: 8px; }
  .frage:last-child { border-bottom: 1px solid var(--line); }
  .frage__titel { font-family: var(--font-display); font-size: 21px; font-weight: 600; }
  .frage__text { line-height: 1.6; color: var(--muted); }
</style>
