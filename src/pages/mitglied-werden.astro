---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import inhalte, { links } from '../lib/inhalte';
import { url } from '../lib/url';

const { sommerSpecial, beitraege, mitgliedschaftBedingungen } = inhalte;

// Der Weg zur Mitgliedschaft – echte Reihenfolge, deshalb nummeriert
const schritte = [
  {
    titel: 'Probetraining',
    text: 'Melde dich über das Kontaktformular mit dem Anliegen „Probetraining“. Wir finden einen Termin, an dem du bei einer passenden Gruppe mitspielen kannst. Falls du noch keine Ausrüstung hast, stellen wir dir einen Schläger.',
    link: { href: url('/kontakt/'), label: 'Probetraining anfragen' },
  },
  {
    titel: 'Online anmelden',
    text: 'Füll das Anmeldeformular aus. Wir melden uns anschließend mit allen weiteren Infos zu Schlüssel, Einführung und Platzbuchung.',
    link: { href: url('/anmeldung/'), label: 'Zur Anmeldung' },
  },
  {
    titel: 'Schlüssel und Einführung',
    text: 'Zu Beginn deiner Mitgliedschaft erhältst du einen Schlüssel für Anlage und Clubhaus sowie eine Einführung durch unseren Sport- oder Jugendwart.',
  },
  {
    titel: 'Plätze buchen',
    text: 'Registriere dich auf der Buchungsseite – beim ersten Mal dort, nicht in der eBuSy-App – und buche kostenfrei, bis zu 14 Tage im Voraus. Für Trainerstunden und den Einstieg in eine Mannschaft helfen Trainer, Sport- und Jugendwart weiter.',
    link: { href: links.platzbuchung, label: 'Zur Platzbuchung ↗' },
  },
];

// PDF-Dateien nach public/dokumente/ legen und hier den Pfad eintragen, z. B. '/dokumente/aufnahmeantrag.pdf'
const dokumente: { titel: string; datei: string | null }[] = [
  { titel: 'Aufnahmeantrag (PDF)', datei: null },
  { titel: 'Abteilungssatzung (PDF)', datei: null },
  { titel: 'Spiel- / Platzordnung (PDF)', datei: null },
];

const fragen = [
  {
    frage: 'Ab welchem Alter kann mein Kind mit dem Tennis anfangen?',
    antwort:
      'Tennis begeistert alle Altersgruppen, und man kann schon von klein auf damit beginnen. Mit Methodikbällen und passenden Schlägern können Kinder ab 4 oder 5 Jahren mit Übungen zur Auge-Hand-Koordination starten.',
  },
  {
    frage: 'Wo kann ich meine Schläger bespannen lassen?',
    antwort:
      'Neue Bespannungen gibt es bei unserem Tennistrainer oder in verschiedenen Sportgeschäften in Ludwigsburg. Wir helfen dir gern weiter.',
  },
  {
    frage: 'Welche Schuhe sind auf dem Sandplatz erlaubt?',
    antwort:
      'Für Sandplätze gibt es Tennisschuhe mit speziellem Profil für einen festen Stand. Zum Ausprobieren reichen auch normale Sportschuhe mit wenig Profil.',
  },
  {
    frage: 'Habt ihr Leihschläger?',
    antwort: 'Ja. Wir helfen dir auch gern, den richtigen Schläger für dich zu finden.',
  },
];
---

<BaseLayout
  title="Mitglied werden"
  description="Mitglied werden beim SKV Eglosheim – Tennis & Padel: Probetraining, Online-Anmeldung, Beiträge und Bedingungen."
>
  <PageIntro titel="Werde jetzt Mitglied">
    Du wolltest schon immer mal Padel oder Tennis ausprobieren und dabei von einem Trainer betreut werden? Oder du spielst
    bereits und möchtest unsere Abteilung kennenlernen? Dann melde dich für ein Probetraining an.
    <div slot="extra" class="btn-row">
      <a href={url('/anmeldung/')} class="btn btn--primary">Online anmelden</a>
      <a href="#beitraege" class="btn btn--outline">Beiträge ansehen</a>
    </div>
  </PageIntro>

  {
    sommerSpecial.aktiv && (
      <section class="special px">
        <div class="special__text">
          <p class="special__titel">
            {sommerSpecial.titel}: {sommerSpecial.kurz}
          </p>
          <p>{sommerSpecial.text}</p>
        </div>
        <a href={url('/anmeldung/')} class="btn btn--white">Jetzt sichern</a>
      </section>
    )
  }

  <!-- Der Weg: vier Schritte -->
  <section id="ablauf" class="weg px" aria-labelledby="weg-titel">
    <h2 id="weg-titel" class="abschnitt__titel">So wirst du Mitglied</h2>
    <ol class="weg__liste">
      {
        schritte.map((s, i) => (
          <li class="weg__schritt">
            <span class="weg__nr" aria-hidden="true">{i + 1}</span>
            <h3 class="weg__titel">{s.titel}</h3>
            <p class="weg__text">{s.text}</p>
            {s.link && (
              <a href={s.link.href} class="link-arrow weg__link">
                {s.link.label}
                {!s.link.label.endsWith('↗') && ' →'}
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Beiträge -->
  <section id="beitraege" class="beitraege px">
    <div class="beitraege__kopf">
      <h2 class="abschnitt__titel">Unsere Beiträge</h2>
      <p class="beitraege__hinweis">{beitraege.hinweis}</p>
    </div>
    <div class="beitraege__tabellen">
      {
        beitraege.gruppen.map((g) => (
          <table class="tabelle tabelle--preise">
            <caption>{g.titel}</caption>
            <tbody>
              {g.tarife.map((t) => (
                <tr>
                  <th scope="row">
                    {t.name} <span class="tabelle__zusatz">{t.zusatz}</span>
                  </th>
                  <td>{t.preis}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ))
      }
    </div>
    <p class="beitraege__aktion">
      <a href={url('/anmeldung/')} class="btn btn--primary">Online anmelden</a>
      <span>Alle Infos zum Hauptverein: <a href={links.hauptverein}>skv-eglosheim.de</a></span>
    </p>
  </section>

  <!-- Bedingungen -->
  <section id="bedingungen" class="bedingungen-abschnitt px">
    <h2 class="abschnitt__titel">Was gilt für Mitglieder?</h2>
    <dl class="bedingungen">
      {
        mitgliedschaftBedingungen.punkte.map((b) => (
          <div>
            <dt>{b.titel}</dt>
            <dd>{b.text}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Fragen und Dokumente -->
  <section id="faq" class="diptychon px">
    <div class="diptychon__text">
      <h2 class="diptychon__titel">Häufige Fragen</h2>
      <p>
        Weitere Fragen? Schreib uns über das <a href={url('/kontakt/')}>Kontaktformular</a> oder schau in unsere{' '}
        <a href={url('/faq/')}>ausführlichen FAQ</a>.
      </p>
      <div class="dokumente">
        <p class="dokumente__titel">Downloads und Dokumente</p>
        <ul>
          {
            dokumente.map((d) =>
              d.datei ? (
                <li>
                  <a href={d.datei}>{d.titel}</a>
                </li>
              ) : (
                <li class="dokumente__folgt">{d.titel} – folgt</li>
              ),
            )
          }
        </ul>
      </div>
    </div>
    <div class="diptychon__beleg">
      <dl class="bedingungen">
        {
          fragen.map((f) => (
            <div>
              <dt>{f.frage}</dt>
              <dd>{f.antwort}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hallmark · genre: editorial · macrostructure: Narrative Workflow · design-system: design.md · designed-as-app
   * tone: Vereinsbrett · anchor hue: 28 · Formen eckig · enrichment: none (typography only)
   * pre-emit critique: P5 H4 E4 S5 R4 V4
   */
  .abschnitt__titel { font-size: var(--text-3xl); font-weight: 700; line-height: 1.05; letter-spacing: -0.03em; text-wrap: balance; }

  /* ---------- Sommer-Special: die eine rote Fläche ---------- */
  .special {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md) var(--space-xl);
    padding-block: var(--space-lg);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .special__text { display: flex; flex-direction: column; gap: var(--space-3xs); max-width: 72ch; }
  .special__titel { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; line-height: 1.2; }
  .special__text p:not(.special__titel) { color: var(--color-on-accent-2); line-height: 1.55; }
  .special :focus-visible { outline-color: var(--color-on-accent); }

  /* ---------- Der Weg ---------- */
  .weg { padding-block: var(--space-2xl); display: flex; flex-direction: column; gap: var(--space-lg); }
  .weg__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
  }
  .weg__schritt {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-top: var(--space-md);
    border-top: var(--rule-strong);
  }
  .weg__nr {
    position: absolute;
    top: calc(-1 * 1.125rem - 1px);
    left: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    background: var(--color-paper);
    border: var(--rule-strong);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .weg__titel { margin-top: var(--space-xs); font-size: var(--text-xl); font-weight: 600; line-height: 1.2; }
  .weg__text { color: var(--color-ink-2); line-height: 1.55; }
  .weg__link { margin-top: auto; padding-top: var(--space-2xs); }

  /* ---------- Beiträge ---------- */
  .beitraege {
    padding-block: var(--space-2xl);
    background: var(--color-paper-2);
    border-block: var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .beitraege__kopf {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-sm) var(--space-2xl);
    align-items: start;
  }
  .beitraege__hinweis { max-width: 64ch; line-height: 1.6; color: var(--color-ink-2); text-wrap: pretty; }
  .beitraege__tabellen { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-lg) var(--space-2xl); align-items: start; }
  .beitraege__aktion { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm) var(--space-md); color: var(--color-ink-2); }

  /* ---------- Bedingungen ---------- */
  .bedingungen-abschnitt { padding-block: var(--space-2xl) var(--space-lg); display: flex; flex-direction: column; gap: var(--space-md); }
  .bedingungen-abschnitt .bedingungen { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-2xl); }
  .bedingungen dd { color: var(--color-ink-2); line-height: 1.55; }

  /* ---------- Fragen und Dokumente ---------- */
  #faq { padding-bottom: var(--space-3xl); }
  .dokumente { margin-top: var(--space-xs); display: flex; flex-direction: column; gap: var(--space-2xs); }
  .dokumente__titel { font-weight: 600; color: var(--color-ink); }
  .dokumente ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-3xs); }
  .dokumente__folgt { color: var(--color-ink-3); }

  @media (min-width: 1200px) {
    .bedingungen-abschnitt .bedingungen { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 1100px) {
    .weg__liste { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--space-xl); }
  }
  @media (max-width: 900px) {
    .beitraege__kopf, .beitraege__tabellen { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .weg__liste { grid-template-columns: minmax(0, 1fr); }
    .bedingungen-abschnitt .bedingungen { grid-template-columns: minmax(0, 1fr); }
  }
</style>
