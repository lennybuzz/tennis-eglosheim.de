---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Bild from '../components/Bild.astro';
import inhalte, { links, mitLinks } from '../lib/inhalte';
import { url } from '../lib/url';

const { anlage, buchung, timeline } = inhalte;
const preise = buchung.preise.filter((p) => p.platz === 'Padel');
// Die Frage nach dem Training verweist auf diese Seite selbst – hier weglassen
const padelFragen = (inhalte.faq.find((g) => g.id === 'padel')?.fragen ?? []).filter((f) => !/training/i.test(f.frage));
const padelChronik = timeline.filter((e) => /padel/i.test(e.titel));
---

<BaseLayout
  title="Padel"
  description={`Padel in Ludwigsburg: ${anlage.padelplaetze} Outdoor-Padelplätze mit Flutlicht beim SKV Eglosheim, buchbar für Mitglieder und Gäste über eBuSy.`}
>
  <PageIntro titel="Padel in Ludwigsburg">
    Seit Juli 2025 die ersten Padelplätze in Ludwigsburg: {anlage.padelplaetze} Outdoor-Plätze mit Flutlicht, offen für
    Mitglieder und Gäste.
    <div slot="extra" class="btn-row">
      <a href={links.platzbuchung} class="btn btn--primary">Platz buchen <span aria-hidden="true">↗</span></a>
      <a href="#training" class="btn btn--outline">Padel-Training</a>
    </div>
  </PageIntro>

  <!-- Die Plätze: Text | Foto + Chronik -->
  <section class="diptychon px">
    <div class="diptychon__text">
      <h2 class="diptychon__titel">Kommt vorbei und spielt mit</h2>
      <p>
        Was im Mai 2025 mit den ersten Baggerarbeiten begann, haben wir am 25. Juli 2025 eröffnet – seit Mai 2026 mit einem
        dritten Platz. Die Plätze stehen nicht nur unseren Mitgliedern offen, sondern können auch von Gästen gebucht werden.
      </p>
      <p>
        Unser Ziel: den TA SKV Eglosheim noch attraktiver für Jung und Alt machen, neue Sportbegeisterte gewinnen und
        unsere Gemeinschaft weiter stärken.
      </p>
      <p class="links">
        <a href={links.instagram} class="link-arrow">Folgt uns auf Instagram ↗</a>
      </p>
    </div>
    <div class="diptychon__beleg">
      <Bild platzhalter="Drohnenfoto der Padelplätze" hoehe="360px" sizes="(max-width: 900px) 100vw, 55vw" eager />
      <table class="tabelle">
        <caption>Vom Bagger zum dritten Platz</caption>
        <tbody>
          {
            padelChronik.map((e) => (
              <tr>
                <th scope="row">{e.datum}</th>
                <td>{e.titel}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- Buchung: Preise | Text -->
  <section id="buchen" class="diptychon diptychon--umgekehrt diptychon--band px">
    <div class="diptychon__text">
      <h2 class="diptychon__titel">Buchen und spielen</h2>
      <p>
        Du buchst online über {buchung.system}, als Doppel- oder als Einzelplatz. Mitglieder der Tennis- &amp; Padelabteilung
        spielen kostenfrei, Gäste zahlen pro Stunde. Padelplatz 0 ist unseren Mitgliedern vorbehalten.
      </p>
      <p>{buchung.leihePadel}</p>
      <p class="klein">
        Die Plätze haben Flutlicht; du schaltest es an der Eingangstür ein und nach dem Spiel bitte wieder aus. Das Tor
        öffnest du mit dem Link aus der KleverKey-E-Mail.
      </p>
      <div class="btn-row">
        <a href={links.platzbuchung} class="btn btn--primary">Platz buchen <span aria-hidden="true">↗</span></a>
        <a href={url('/#so-gehts')} class="btn btn--outline">So buchst du</a>
      </div>
    </div>
    <div class="diptychon__beleg diptychon__beleg--zweispaltig">
      <div class="beleg__block">
        <table class="tabelle tabelle--gast">
          <caption>Preise pro Stunde</caption>
          <thead>
            <tr>
              <th scope="col">Zeit</th>
              <th scope="col">Gäste</th>
              <th scope="col">SKV-Mitglieder<span class="tabelle__zusatz"> andere Abteilungen</span></th>
            </tr>
          </thead>
          <tbody>
            {
              preise.map((p) => (
                <tr>
                  <th scope="row">{p.zeitraum}</th>
                  <td>{p.gast}</td>
                  <td>{p.skv}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="beleg__hinweis">Mitglieder der Tennis- &amp; Padelabteilung spielen kostenfrei.</p>
      </div>
      <div class="beleg__block">
        <table class="tabelle">
          <caption>Spielzeiten</caption>
          <tbody>
            {
              buchung.spielzeiten.map((s) => (
                <tr>
                  <th scope="row">{s.tage}</th>
                  <td>{s.zeit}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Neu bei Padel und Training: Text | Fragen -->
  <section id="training" class="diptychon px">
    <div class="diptychon__text">
      <h2 class="diptychon__titel">Neu bei Padel?</h2>
      <p>
        Padel ist in wenigen Minuten erklärt und macht vom ersten Ballwechsel an Spaß. Die wichtigsten Antworten stehen
        hier, alle weiteren in unseren häufigen Fragen.
      </p>
      <p class="links">
        <a href={url('/faq/#padel')} class="link-arrow">Alle Fragen zu Padel →</a>
      </p>
      <h3 class="unter">Padel-Training</h3>
      <p>Padel-Training ist neu im Angebot. Schreib uns, wenn du mitmachen möchtest – wir sagen dir, wann die nächste Gruppe startet.</p>
      <div class="btn-row">
        <a href={url('/kontakt/')} class="btn btn--primary">Training anfragen</a>
        <a href={url('/mitglied-werden/')} class="btn btn--outline">Mitglied werden</a>
      </div>
    </div>
    <div class="diptychon__beleg">
      <dl class="bedingungen">
        {
          padelFragen.map((f) => (
            <div>
              <dt>{f.frage}</dt>
              <dd set:html={mitLinks(f.antwort)} />
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hallmark · genre: editorial · macrostructure: Split Studio · design-system: design.md · designed-as-app
   * tone: Vereinsbrett · anchor hue: 28 · Formen eckig · enrichment: ein Foto (Platzhalter bis echtes Bild)
   * pre-emit critique: P4 H4 E4 S5 R5 V4
   */
  .beleg__block { display: flex; flex-direction: column; gap: var(--space-2xs); min-width: 0; }
  .beleg__hinweis { font-size: var(--text-sm); line-height: 1.5; color: var(--color-ink-3); }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-md); }
  .diptychon:last-of-type { padding-bottom: var(--space-3xl); }
  .bedingungen dd { color: var(--color-ink-2); line-height: 1.55; }
  .unter { margin-top: var(--space-md); font-size: var(--text-xl); font-weight: 600; }
</style>
