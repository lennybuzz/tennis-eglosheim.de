# Apache-Konfiguration für den Webspace (wird beim Build nach dist/ kopiert)

ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Immer https und www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L]

  # Weiterleitungen von der alten WordPress-Seite
  RewriteRule ^verein/tennisanlage/?$                   /verein/ [R=301,L]
  RewriteRule ^tennis/mannschaften(/.*)?$               /tennis/#spielbetrieb [R=301,L,NE]
  RewriteRule ^padel/padel-training/?$                  /padel/#training [R=301,L,NE]
  RewriteRule ^news/?$                                  / [R=301,L]
  RewriteRule ^post/(eroeffnung-der-plaetze|baubeginn-unserer-padelplaetze)/?$  /padel/ [R=301,L]
  RewriteRule ^post/.*$                                 / [R=301,L]
  RewriteRule ^category/.*$                             / [R=301,L]
  RewriteRule ^(wp-admin|wp-login\.php|verwaltung)(/.*)?$  / [R=302,L]
  RewriteRule ^(page-|post-|category-|post_tag-|author-|fusion_tb_category-|element_category-)?sitemap\.xml$  /sitemap-index.xml [R=301,L]
  RewriteRule ^wp-sitemap\.xml$                         /sitemap-index.xml [R=301,L]
</IfModule>

# Zugangsdaten für das Kontaktformular niemals ausliefern
<Files "kontakt-config.php">
  Require all denied
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Dateien in /_astro/ haben einen Hash im Namen und ändern sich nie
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
